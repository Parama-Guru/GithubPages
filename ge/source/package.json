{
  "name": "ganesh-electricals-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools",
    "format": "prettier --write src tests tools",
    "assets": "node tools/build-assets.mjs",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.ts --outDir dist-ssr && node tools/prerender.mjs",
    "publish:local": "node tools/publish-local.mjs",
    "serve": "node tools/serve.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "media": "node tools/build-media.mjs",
    "posters": "node tools/render-posters.mjs"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-glsl": "1.6.2",
    "vitest": "5.0.3"
  }
}
